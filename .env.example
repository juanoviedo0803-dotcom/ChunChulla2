# Obligatoria: nombre de la cuenta
BOT_USERNAME=Sephera

# Solo si el servidor pide /login. En local va en .env (ignorado por git);
# en Railway, como variable del servicio.
PASSWORD=

# Servidor (por defecto JartexNetwork). Prefijo MC_ a propósito: Railway define
# PORT y HOST por su cuenta y no deben pisar los del juego.
# MC_HOST=play.jartexnetwork.com
# MC_PORT=25565
# MC_VERSION=1.8.9

# Entrada al modo de juego.
# Por defecto: usar el ítem del hotbar 0 (la brújula) y clickear el icono de
# Prison en el menú "Server Selector" (Iron Bars / barrotes, slot 14).
# Vacío en un *_MATCH = esa comprobación no se aplica.
# ENTRY_COMMAND=/prison
# ENTRY_HOTBAR_SLOT=0
# ENTRY_MENU_MATCH=Server Selector
# ENTRY_ITEM_MATCH=iron_bars

# Línea del chat que confirma la entrada
# IN_GAME_MATCH=You are connected to Prison

# Reintentos antes de reconectar
# ENTRY_TIMEOUT_MS=20000
# ENTRY_ATTEMPTS=3
